# Created at runtime
easydpi.log
bin/config.ini
bin/blacklist.txt

# Resolver list cache, rewritten by dnscrypt-proxy whenever it refreshes.
# The pristine copies the release archive is built from live in dns/seed/.
dns/*.md
dns/*.minisig

# Design mockups kept locally for reference, too large to publish
.design-source/

# Portable Git used by push.cmd; a local convenience, not part of the project
.tools/
push.cmd

# Build leftovers
*.pdb
*.obj
*.suo
*.user

# Diagnostic reports written by the Save report button, including when the app
# is run from this folder during development.
easydpi-report-*.txt
